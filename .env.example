# COMP4117 Inventory Management System - Environment Configuration
# Copy this file to backend/.env and fill in your values

# ============================================================================
# REQUIRED: Database Configuration
# ============================================================================
# MongoDB connection URI - Choose one of the formats below:

# Azure Cosmos DB (example):
# MONGODB_URI=mongodb://username:password@host.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@username@

# Self-hosted MongoDB (local):
# MONGODB_URI=mongodb://localhost:27017/inventory_db

# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventory?retryWrites=true&w=majority

# Set your actual connection string:
MONGODB_URI=mongodb://username:password@host:port/database

# ============================================================================
# REQUIRED: Authentication & Security
# ============================================================================
# JWT Secret - CRITICAL: Use a strong random string in production
# Generate using: 
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-secret-key-generate-using-command-above

# JWT Token Expiration (e.g., "24h", "7d", "30d", "1y")
JWT_EXPIRES_IN=24h

# ============================================================================
# SERVER Configuration
# ============================================================================
# Server port
PORT=5001

# Environment (development | staging | production)
# - development: logs all requests, detailed errors, hot-reload
# - staging: logs important requests, full error details
# - production: minimal logging, error messages hidden from clients
NODE_ENV=development

# Frontend port (for development info logging)
FRONTEND_PORT=3000

# ============================================================================
# CORS Configuration - Cross-Origin Resource Sharing
# ============================================================================
# Comma-separated list of allowed origins
# For development (multiple local ports):
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5001

# For production (your domain):
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
# 
# LOCAL DEVELOPMENT:
# 1. Copy this file to backend/.env
# 2. Keep localhost URLs and test database
# 3. Run: npm install && npm run dev
#
# PRODUCTION DEPLOYMENT:
# 1. Update MONGODB_URI to your production database
# 2. Generate a strong JWT_SECRET (see command above)
# 3. Update NODE_ENV to "production"
# 4. Update CORS_ORIGINS to your production domain(s)
# 5. Deploy: npm start (requires environment variables set)
#
# ============================================================================
